<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LoudnessCorrectionFilterGUIDialog</class>
 <widget class="QDialog" name="LoudnessCorrectionFilterGUIDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>640</width>
    <height>650</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>520</width>
    <height>540</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Listening-level calibration</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing"><number>8</number></property>
   <property name="leftMargin"><number>12</number></property>
   <property name="topMargin"><number>12</number></property>
   <property name="rightMargin"><number>12</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <item>
    <widget class="QLabel" name="titleLabel">
     <property name="text"><string>Calibrate your listening position</string></property>
     <property name="accessibleName"><string>Calibration wizard</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="subtitleLabel">
     <property name="text"><string>Use a sound-level meter with slow response and Z weighting. Complete the three steps below.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="safetyStatusLabel">
     <property name="text"><string>The equal-loudness contour is temporarily disabled while this window is open; APO volume follow remains active when enabled.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="speakerStepGroup">
     <property name="title"><string>1 · Choose one speaker</string></property>
     <layout class="QVBoxLayout" name="speakerStepLayout">
      <property name="spacing"><number>6</number></property>
      <item>
       <widget class="QLabel" name="speakerHintLabel">
        <property name="text"><string>Measure a single speaker so the reference level is not inflated by summing both channels.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="channelLayout">
        <item>
         <widget class="QRadioButton" name="leftRadioButton">
          <property name="text"><string>Left speaker</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item><widget class="QRadioButton" name="rightRadioButton"><property name="text"><string>Right speaker</string></property></widget></item>
        <item><widget class="QRadioButton" name="bothRadioButton"><property name="text"><string>Both speakers</string></property></widget></item>
        <item>
         <spacer name="speakerSpacer">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="playbackStepGroup">
     <property name="title"><string>2 · Play the calibration signal</string></property>
     <layout class="QVBoxLayout" name="playbackStepLayout">
      <property name="spacing"><number>6</number></property>
      <item>
       <widget class="QLabel" name="playbackHintLabel">
        <property name="text"><string>Set application volume to full, keep your normal Windows or hardware volume position, then play the pink-noise signal.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QGridLayout" name="playbackControlsLayout">
        <item row="0" column="0">
         <widget class="QPushButton" name="playButton">
          <property name="text"><string>Play pink noise</string></property>
          <property name="accessibleDescription"><string>Starts a looping pink-noise signal on the selected speaker</string></property>
         </widget>
        </item>
        <item row="0" column="1"><widget class="QPushButton" name="stopButton"><property name="text"><string>Stop</string></property></widget></item>
        <item row="0" column="2">
         <spacer name="playbackSpacer">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
        <item row="1" column="0" colspan="3">
         <widget class="QLabel" name="playbackStatusLabel">
          <property name="text"><string>Ready to play</string></property>
          <property name="wordWrap"><bool>true</bool></property>
          <property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="measurementStepGroup">
     <property name="title"><string>3 · Enter the measured level</string></property>
     <layout class="QVBoxLayout" name="measurementStepLayout">
      <property name="spacing"><number>6</number></property>
      <item>
       <widget class="QLabel" name="measurementHintLabel">
        <property name="text"><string>Measure at the listening position and enter the meter reading. The result becomes the 1 kHz reference at 0 dB tracked volume.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="measurementControlsLayout">
        <item><widget class="QLabel" name="levelLabel"><property name="text"><string>Measured at listening position:</string></property></widget></item>
        <item>
         <widget class="QSpinBox" name="levelSpinBox">
          <property name="minimum"><number>1</number></property>
          <property name="maximum"><number>100</number></property>
          <property name="value"><number>75</number></property>
         </widget>
        </item>
        <item>
         <spacer name="measurementSpacer">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="footerHintLabel">
     <property name="text"><string>After saving, continue using the same Windows-volume or hardware-knob method selected in the filter.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>12</height></size></property>
    </spacer>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Save</set></property>
    </widget>
   </item>
  </layout>
 </widget>
 <tabstops>
  <tabstop>leftRadioButton</tabstop>
  <tabstop>rightRadioButton</tabstop>
  <tabstop>bothRadioButton</tabstop>
  <tabstop>playButton</tabstop>
  <tabstop>stopButton</tabstop>
  <tabstop>levelSpinBox</tabstop>
 </tabstops>
