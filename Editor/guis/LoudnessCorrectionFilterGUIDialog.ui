 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>LoudnessCorrectionFilterGUIDialog</receiver><slot>accept()</slot><hints/></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>LoudnessCorrectionFilterGUIDialog</receiver><slot>reject()</slot><hints/></connection>
