  <property name="styleSheet">
   <string notr="true">QDialog#UpdateCheckerClass {
 background: palette(window);
 color: palette(window-text);
}
QFrame#headerPanel, QFrame#contentPanel {
 background: palette(alternate-base);
 border: 1px solid palette(mid);
}
QLabel#sectionLabel {
 color: palette(highlight);
 font-weight: 600;
}
QLabel#titleLabel {
 font-size: 22px;
 font-weight: 700;
}
QLabel#summaryLabel, QLabel[caption="true"] {
 color: palette(placeholder-text);
}
QLabel#installedVersionLabel, QLabel#availableVersionLabel {
 font-family: "Cascadia Mono", "Consolas";
 font-weight: 600;
}
QTextEdit#versionBrowser {
 background: palette(base);
 color: palette(text);
 border: 1px solid palette(mid);
 selection-background-color: palette(highlight);
 selection-color: palette(highlighted-text);
}
</string>
