#include <winres.h>
#include "../version.h"

#define HIBIKI_STRINGIZE_INNER(value) #value
#define HIBIKI_STRINGIZE(value) HIBIKI_STRINGIZE_INNER(value)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MAJOR,MINOR,REVISION,0
 PRODUCTVERSION MAJOR,MINOR,REVISION,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Hibiki EQAPO"
            VALUE "FileVersion", HIBIKI_STRINGIZE(MAJOR) "." HIBIKI_STRINGIZE(MINOR) "." HIBIKI_STRINGIZE(REVISION) ".0"
            VALUE "InternalName", "HibikiEQAPODriver.dll"
            VALUE "LegalCopyright", "Copyright (C) Hibiki EQAPO contributors"
            VALUE "OriginalFilename", "HibikiEQAPODriver.dll"
            VALUE "ProductName", "Hibiki EQAPO"
            VALUE "ProductVersion", HIBIKI_STRINGIZE(MAJOR) "." HIBIKI_STRINGIZE(MINOR) "." HIBIKI_STRINGIZE(REVISION) ".0"
			VALUE "Comments", "ASIO proxy CLSID {D47C55C9-3F7D-422F-86E9-32E170815D53}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
